ENVIRONMENT=development
APP_NAME=VidoraAI
VIDEO_RETENTION_HOURS=24
POOL_PRE_PING=true
POOL_SIZE=5
MAX_OVERFLOW=10
POOL_RECYCLE=1800
AI_ENABLED=true
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
GROQ_API_KEY=
GROQ_API_KEY_FALLBACK=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES_CSV=localhost,vidoraa.com,www.vidoraa.com
GOOGLE_CREDENTIALS_PATH=
GCP_PROJECT_ID=
YOUTUBE_COOKIE_SECRET_IDS=[]
CORS_ORIGINS_CSV=http://localhost:5173,http://127.0.0.1:5173,https://a2r-vidora.vercel.app,https://vidoraa.com
CHAT_MODEL=openai/gpt-oss-20b
STT_MODEL=whisper-large-v3
# Bounded per-video parallel Groq requests; shared quotas are enforced separately.
STT_CONCURRENCY=3
STT_REQUESTS_PER_MINUTE=19
STT_REQUESTS_PER_DAY=1990
STT_AUDIO_SECONDS_PER_HOUR=7200
STT_AUDIO_SECONDS_PER_DAY=28800
ANSWER_MAX_TOKENS=1024
ANSWER_TEMPERATURE=0.2
PROVIDER_TIMEOUT_SECONDS=60
SUMMARY_MAX_TOKENS=400
SUMMARY_MAX_INPUT_CHARS=20000
SUBMIT_LIMIT=5
SUBMIT_WINDOW_SECONDS=600
QUESTION_LIMIT=10
QUESTION_WINDOW_SECONDS=600
RATE_LIMIT_TRUSTED_PROXY_HOPS=0
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify
RECAPTCHA_TIMEOUT_SECONDS=5
COOKIE_CACHE_TTL_SECONDS=1800
MAX_VIDEO_DURATION_SECONDS=10800
ANONYMOUS_MAX_VIDEO_DURATION_SECONDS=2100
DOWNLOAD_TIMEOUT_SECONDS=20
DOWNLOAD_RETRIES=2
AUDIO_QUALITY=64
ANALYSIS_TIMEOUT_SECONDS=270
STALE_PROCESSING_SECONDS=1200
TASK_FUNCTION_TIMEOUT_SECONDS=900
TARGET_CHUNK_CHARS=500
MAX_CHUNK_CHARS=800
MAX_QUESTION_CHARS=2000
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
VIDORA_FUNCTION_MAX_INSTANCES=10
VIDORA_FUNCTION_MEMORY_MB=2048
VIDORA_FUNCTION_CPU=1
VIDORA_FUNCTION_TIMEOUT_SECONDS=300
VIDORA_FUNCTION_CONCURRENCY=2
TASK_MAX_ATTEMPTS=3
TASK_MAX_CONCURRENT_DISPATCHES=3
VIDEO_PROCESSING_TASK=processvideo
CLEANUP_SCHEDULE=every 24 hours
QA_PAGE_SIZE=20
QA_MAX_PAGE_SIZE=100
RETRIEVAL_SHORT_SECONDS=600
RETRIEVAL_MEDIUM_SECONDS=1800
RETRIEVAL_SHORT_K=5
RETRIEVAL_MEDIUM_K=8
RETRIEVAL_LONG_K=12
RETRIEVAL_CANDIDATE_MULTIPLIER=4
RETRIEVAL_MIN_CANDIDATES=20
RETRIEVAL_RRF_K=60

# Production VAD chunking and local listening preview.
VAD_THRESHOLD=0.5
VAD_NEG_THRESHOLD=0.35
VAD_MIN_SPEECH_MS=250
VAD_MIN_SILENCE_MS=100
VAD_MERGE_PAUSE_MS=600
VAD_SPEECH_PAD_MS=150
VAD_MAX_CHUNK_SECONDS=30
VAD_GROUP_TARGET_SECONDS=20
VAD_SPLIT_OVERLAP_MS=250
VAD_MAX_AUDIO_SECONDS=10805
VAD_STT_REQUEST_SECONDS=240
VAD_STT_REQUEST_BYTES=20000000
