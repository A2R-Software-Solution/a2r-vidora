# Optional Firebase emulator secret overrides. Copy to .secret.local only
# when supplying real development credentials. Never commit .secret.local.
# Production secrets are managed by Firebase/Google Secret Manager, not dotenv.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
# GROQ_API_KEY=your_development_key
# GROQ_API_KEY_FALLBACK=your_optional_development_key
# RECAPTCHA_SECRET_KEY=your_development_secret
