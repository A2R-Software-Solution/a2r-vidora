# Prerendered pages live at <page>/index.html, but their canonical URL has no trailing
# slash (/terms, not /terms/). Serve them at that one URL; any other path is a real 404.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # www.vidoraa.com -> vidoraa.com, so Google sees one site instead of two.
  RewriteCond %{HTTP_HOST} ^www\.vidoraa\.com$ [NC]
  RewriteRule ^(.*)$ https://vidoraa.com/$1 [R=301,L]

  # /terms/ -> /terms, so each page has a single URL.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # /terms -> terms/index.html, served directly (no slash-adding redirect).
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+)$ /$1/index.html [L]

  # Client-side routes with no prerendered page.
  RewriteRule ^admin/?$ /index.html [L]

  # Other folders (e.g. /assets) are not pages.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^.+$ - [R=404,L]
</IfModule>

# Unknown paths get a 404 status (index.html with 200 is a "soft 404" to Google); the
# app shows its "Page not found" view for them.
ErrorDocument 404 /index.html

# Vite gives built JS/CSS a content hash (index-AbC123xy.js), so a changed file gets a new
# name: cache those for a year. HTML must be rechecked so a deploy shows up straight away.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
